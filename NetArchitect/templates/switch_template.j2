! NetArchitect generated Cisco IOS Layer 2 switch baseline
! Review platform-specific syntax and interface inventory before deployment.
hostname {{ hostname }}-SW1
!
{% for vlan in vlans %}
vlan {{ vlan.vlan_id }}
 name {{ vlan.name | replace(" ", "_") | upper }}
{% endfor %}
!
{% if vlans %}
interface GigabitEthernet0/1
 description UPLINK_TO_DISTRIBUTION_OR_CORE
 switchport mode trunk
 switchport trunk allowed vlan {{ vlans | map(attribute="vlan_id") | join(",") }}
 no shutdown
{% endif %}
!
spanning-tree mode rapid-pvst
!
! Assign access ports only after the physical port-to-VLAN map is confirmed.
! Example:
! interface GigabitEthernet0/2
!  description USER_ACCESS_PORT
!  switchport mode access
!  switchport access vlan <approved-vlan-id>
!  spanning-tree portfast
!  spanning-tree bpduguard enable
!
end
